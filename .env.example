# 复制为 .env 后填写，.env 不进 Git

# 录播姬网页管理界面的登录账号（只通过 SSH 隧道访问，不对公网开放端口）
BREC_HTTP_BASIC_USER=admin
BREC_HTTP_BASIC_PASS=change-me-to-a-long-random-password

# 录像在服务器上的存放目录（建议挂载数据盘到 /data）
REC_DIR=/data/rec

# 阿里云 OSS（阶段 0 可选：录像内网同步到同地域 OSS）
OSS_BUCKET=
OSS_ENDPOINT_INTERNAL=oss-cn-beijing-internal.aliyuncs.com

# 阿里云百炼（阶段 0 试用、阶段 2 正式使用）
DASHSCOPE_API_KEY=
# 可选：默认 https://dashscope.aliyuncs.com/compatible-mode/v1；也可换成控制台里的业务空间专属地址
DASHSCOPE_BASE_URL=
# 可选：默认 qwen3-vl-flash；控制台模型列表里没有就换成能用的视觉模型，如 qwen3-vl-plus
DASHSCOPE_MODEL=

# 监控告警推送（任选一个或多个，见 deploy/monitor/README.md）
SERVERCHAN_SENDKEY=
PUSHPLUS_TOKEN=
WECOM_WEBHOOK=
DINGTALK_WEBHOOK=
