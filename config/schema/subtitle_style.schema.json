{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kiya-clipper/subtitle_style",
  "title": "字幕样式",
  "description": "一套字幕样式。worker 用它烧录字幕；后台管理用它生成编辑表单并校验。尺寸类数值以 1080p 画面为基准，其他分辨率自动等比缩放。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name":            {"type": "string",  "title": "样式名称", "default": "未命名样式"},
    "font":            {"type": "string",  "title": "字体", "description": "字体族名，需已安装在服务器上或放在仓库 fonts/ 目录", "default": "Noto Sans CJK SC"},
    "font_size":       {"type": "integer", "title": "字号", "minimum": 20, "maximum": 200, "default": 64},
    "bold":            {"type": "boolean", "title": "加粗", "default": true},
    "spacing":         {"type": "number",  "title": "字间距", "minimum": 0, "maximum": 20, "default": 0},
    "color":           {"type": "string",  "title": "文字颜色", "format": "color", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$", "default": "#FFFFFF"},
    "outline_color":   {"type": "string",  "title": "描边颜色", "format": "color", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$", "default": "#000000"},
    "outline":         {"type": "number",  "title": "描边粗细", "minimum": 0, "maximum": 20, "default": 4},
    "shadow":          {"type": "number",  "title": "阴影距离", "minimum": 0, "maximum": 20, "default": 1},
    "shadow_color":    {"type": "string",  "title": "阴影颜色", "format": "color", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$", "default": "#00000080"},
    "box":             {"type": "boolean", "title": "底框", "description": "开启后文字下方显示色块，描边设置不再生效", "default": false},
    "box_color":       {"type": "string",  "title": "底框颜色", "format": "color", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$", "default": "#000000A0"},
    "box_padding":     {"type": "number",  "title": "底框内边距", "minimum": 0, "maximum": 40, "default": 10},
    "position":        {"type": "string",  "title": "位置", "enum": ["bottom", "middle", "top"], "enumNames": ["底部", "中间", "顶部"], "default": "bottom"},
    "margin_v":        {"type": "integer", "title": "上下边距", "minimum": 0, "maximum": 500, "default": 70},
    "margin_h":        {"type": "integer", "title": "左右边距", "minimum": 0, "maximum": 500, "default": 60},
    "max_chars":       {"type": "integer", "title": "每条最多字数", "description": "超过就在停顿处拆成多条依次显示", "minimum": 6, "maximum": 40, "default": 16},
    "min_duration":    {"type": "number",  "title": "每条最短显示秒数", "minimum": 0.2, "maximum": 3, "default": 0.6},
    "strip_punct":     {"type": "boolean", "title": "去掉逗号句号", "description": "问号、感叹号保留", "default": true},
    "karaoke":         {"type": "boolean", "title": "逐字变色（卡拉 OK）", "description": "按语音识别的词时间戳逐字变色；开启后关键词换色不生效", "default": false},
    "karaoke_color":   {"type": "string",  "title": "已读文字颜色", "format": "color", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$", "default": "#FFD54A"},
    "highlight":       {"type": "boolean", "title": "关键词换色", "default": true},
    "highlight_color": {"type": "string",  "title": "关键词颜色", "format": "color", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$", "default": "#FF7EB6"},
    "highlight_lore":  {"type": "boolean", "title": "主播专属词自动换色", "description": "主播档案里的昵称、粉丝名、专属梗自动作为关键词", "default": true},
    "highlight_words": {"type": "array",   "title": "额外关键词", "items": {"type": "string"}, "default": []}
  }
}
